generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum CustomerActivityType {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
  EXPIRED
}

enum SubscriptionActivityType {
  CREATED
  TRIAL_STARTED
  ACTIVATED
  PAST_DUE
  PAUSED
  RESUMED
  CANCEL_SCHEDULED
  CANCELED
  RENEWED
  EXPIRED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum InvoiceActivityType {
  CREATED
  ISSUED
  VOIDED
  MARKED_UNCOLLECTIBLE
  PAYMENT_RECORDED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  PAYMENT_REFUND_REQUESTED
  PAYMENT_REFUNDED
  PAYMENT_REFUND_FAILED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  CHECK
  OTHER
}

enum PaymentSource {
  MANUAL
  GATEWAY
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum GatewayWebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum AutomationJobType {
  RENEWAL_REMINDER
  TRIAL_ENDING_REMINDER
  TRIAL_ACTIVATION
  RECURRING_INVOICE
  CANCEL_AT_PERIOD_END
  STATUS_SYNC
  PAYMENT_RECOVERY
  SUBSCRIPTION_EXPIRATION
}

enum AutomationQueueName {
  BILLING
  NOTIFICATIONS
}

enum AutomationJobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DEAD_LETTER
  CANCELED
}

enum NotificationType {
  RENEWAL_UPCOMING
  TRIAL_ENDING
  INVOICE_GENERATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  SUBSCRIPTION_CANCELED
  REFUND_UPDATED
}

enum NotificationStatus {
  PENDING
  QUEUED
  SENDING
  SENT
  FAILED
  DEAD_LETTER
  SKIPPED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  name         String    @db.VarChar(160)
  passwordHash String    @db.VarChar(100)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  memberships OrganizationMember[]
  sessions    Session[]

  @@map("users")
}

model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(160)
  slug            String   @unique @db.VarChar(80)
  defaultCurrency String   @default("USD") @db.VarChar(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  members                OrganizationMember[]
  activeSessions         Session[]             @relation("ActiveOrganizationSessions")
  customers              Customer[]
  customerActivities     CustomerActivity[]
  plans                  Plan[]
  subscriptions          Subscription[]
  subscriptionActivities SubscriptionActivity[]
  invoices               Invoice[]
  invoiceLineItems       InvoiceLineItem[]
  invoiceActivities      InvoiceActivity[]
  payments               Payment[]
  paymentRefunds         PaymentRefund[]
  invoiceCounter         InvoiceCounter?
  automationJobs         AutomationJob[]
  notifications          Notification[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  tokenHash            String   @unique @db.VarChar(64)
  userId               String   @db.Uuid
  activeOrganizationId String?  @db.Uuid
  expiresAt            DateTime @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt           DateTime @default(now()) @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation("ActiveOrganizationSessions", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @db.Uuid
  name                String         @db.VarChar(160)
  email               String         @db.VarChar(320)
  phone               String?        @db.VarChar(40)
  company             String?        @db.VarChar(160)
  billingAddressLine1 String?        @db.VarChar(160)
  billingAddressLine2 String?        @db.VarChar(160)
  billingCity         String?        @db.VarChar(100)
  billingRegion       String?        @db.VarChar(100)
  billingPostalCode   String?        @db.VarChar(40)
  billingCountry      String?        @db.VarChar(80)
  notes               String?        @db.Text
  externalId          String?        @db.VarChar(160)
  status              CustomerStatus @default(ACTIVE)
  metadata            Json?
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activities    CustomerActivity[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("customers")
}

model CustomerActivity {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  customerId     String               @db.Uuid
  type           CustomerActivityType
  message        String               @db.VarChar(500)
  actorId        String?              @db.Uuid
  actorName      String?              @db.VarChar(160)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId, createdAt])
  @@map("customer_activities")
}

model Plan {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String          @db.VarChar(120)
  code           String          @db.VarChar(60)
  description    String?         @db.Text
  amountMinor    Int             @db.Integer
  currency       String          @default("USD") @db.VarChar(3)
  interval       BillingInterval @default(MONTH)
  trialDays      Int             @default(0) @db.Integer
  status         PlanStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  customerId         String             @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  quantity           Int                @default(1) @db.Integer
  startedAt          DateTime           @db.Timestamptz(3)
  trialEndsAt        DateTime?          @db.Timestamptz(3)
  currentPeriodStart DateTime           @db.Timestamptz(3)
  currentPeriodEnd   DateTime           @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?          @db.Timestamptz(3)
  pausedAt           DateTime?          @db.Timestamptz(3)
  endedAt            DateTime?          @db.Timestamptz(3)
  planName           String             @db.VarChar(120)
  planCode           String             @db.VarChar(60)
  unitAmountMinor    Int                @db.Integer
  currency           String             @db.VarChar(3)
  interval           BillingInterval
  trialDays          Int                @default(0) @db.Integer
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer              @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan         Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]
  activities   SubscriptionActivity[]

  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, currentPeriodEnd])
  @@index([organizationId, startedAt])
  @@index([organizationId, endedAt])
  @@index([organizationId, canceledAt])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

model SubscriptionActivity {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @db.Uuid
  subscriptionId String                    @db.Uuid
  type           SubscriptionActivityType
  message        String                    @db.VarChar(500)
  actorId        String?                   @db.Uuid
  actorName      String?                   @db.VarChar(160)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, subscriptionId, createdAt])
  @@map("subscription_activities")
}

model InvoiceCounter {
  organizationId String @id @db.Uuid
  nextNumber     Int    @default(1) @db.Integer

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("invoice_counters")
}

model Invoice {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @db.Uuid
  customerId          String        @db.Uuid
  subscriptionId      String?       @db.Uuid
  number              String        @db.VarChar(60)
  status              InvoiceStatus @default(DRAFT)
  currency            String        @db.VarChar(3)
  subtotalMinor       Int           @db.Integer
  taxMinor            Int           @default(0) @db.Integer
  totalMinor          Int           @db.Integer
  amountPaidMinor     Int           @default(0) @db.Integer
  taxRateBps          Int           @default(0) @db.Integer
  dueInDays           Int           @default(7) @db.Integer
  periodStart         DateTime?     @db.Timestamptz(3)
  periodEnd           DateTime?     @db.Timestamptz(3)
  customerName        String        @db.VarChar(160)
  customerEmail       String        @db.VarChar(320)
  customerCompany     String?       @db.VarChar(160)
  billingAddressLine1 String?       @db.VarChar(160)
  billingAddressLine2 String?       @db.VarChar(160)
  billingCity         String?       @db.VarChar(100)
  billingRegion       String?       @db.VarChar(100)
  billingPostalCode   String?       @db.VarChar(40)
  billingCountry      String?       @db.VarChar(80)
  issuedAt            DateTime?     @db.Timestamptz(3)
  dueAt               DateTime?     @db.Timestamptz(3)
  paidAt              DateTime?     @db.Timestamptz(3)
  voidedAt            DateTime?     @db.Timestamptz(3)
  uncollectibleAt     DateTime?     @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription Subscription?       @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  lineItems    InvoiceLineItem[]
  activities   InvoiceActivity[]
  payments     Payment[]
  refunds      PaymentRefund[]

  @@unique([organizationId, number])
  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([organizationId, status])
  @@index([organizationId, customerId])
  @@index([organizationId, createdAt])
  @@index([organizationId, periodEnd])
  @@index([organizationId, issuedAt])
  @@index([organizationId, dueAt])
  @@index([customerId])
  @@index([subscriptionId])
  @@map("invoices")
}

model InvoiceLineItem {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @db.Uuid
  invoiceId        String @db.Uuid
  description      String @db.VarChar(300)
  quantity         Int    @db.Integer
  unitAmountMinor  Int    @db.Integer
  totalMinor       Int    @db.Integer
  position         Int    @default(0) @db.Integer

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, invoiceId])
  @@map("invoice_line_items")
}

model InvoiceActivity {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  invoiceId      String              @db.Uuid
  type           InvoiceActivityType
  message        String              @db.VarChar(500)
  actorId        String?             @db.Uuid
  actorName      String?             @db.VarChar(160)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, invoiceId, createdAt])
  @@map("invoice_activities")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  invoiceId      String        @db.Uuid
  amountMinor    Int           @db.Integer
  currency       String        @db.VarChar(3)
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  source         PaymentSource @default(MANUAL)
  reference      String?       @db.VarChar(160)
  note           String?       @db.VarChar(500)
  gatewayProvider     String?   @db.VarChar(40)
  gatewayOrderId      String?   @db.VarChar(160)
  gatewayPaymentId    String?   @db.VarChar(160)
  gatewayStatus       String?   @db.VarChar(80)
  gatewayMetadata     Json?
  refundedAmountMinor Int       @default(0) @db.Integer
  paidAt         DateTime?     @db.Timestamptz(3)
  failedAt       DateTime?     @db.Timestamptz(3)
  refundedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  refunds      PaymentRefund[]

  @@unique([gatewayProvider, gatewayOrderId])
  @@unique([gatewayProvider, gatewayPaymentId])
  @@index([organizationId, invoiceId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, gatewayPaymentId])
  @@index([organizationId, paidAt])
  @@index([organizationId, refundedAt])
  @@index([invoiceId])
  @@map("payments")
}

model PaymentRefund {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  invoiceId        String              @db.Uuid
  paymentId        String              @db.Uuid
  provider         String              @db.VarChar(40)
  providerRefundId String?             @db.VarChar(160)
  amountMinor      Int                 @db.Integer
  currency         String              @db.VarChar(3)
  status           PaymentRefundStatus @default(PENDING)
  reason           String?             @db.VarChar(500)
  metadata         Json?
  processedAt      DateTime?           @db.Timestamptz(3)
  failedAt         DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRefundId])
  @@index([organizationId, paymentId, createdAt])
  @@index([organizationId, invoiceId, createdAt])
  @@index([organizationId, processedAt])
  @@map("payment_refunds")
}

model AutomationJob {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  type               AutomationJobType
  queue              AutomationQueueName
  status             AutomationJobStatus @default(PENDING)
  idempotencyKey     String              @unique @db.VarChar(240)
  targetType         String              @db.VarChar(60)
  targetId           String?             @db.Uuid
  runAt              DateTime            @db.Timestamptz(3)
  attempts           Int                 @default(0) @db.Integer
  maxAttempts        Int                 @default(5) @db.Integer
  dispatchGeneration Int                 @default(0) @db.Integer
  lockedAt           DateTime?           @db.Timestamptz(3)
  lockedBy           String?             @db.VarChar(120)
  lastError          String?             @db.Text
  resultSummary      String?             @db.VarChar(500)
  startedAt          DateTime?           @db.Timestamptz(3)
  finishedAt         DateTime?           @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, runAt])
  @@index([status, runAt])
  @@index([queue, status])
  @@index([organizationId, type, targetId, createdAt])
  @@map("automation_jobs")
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  customerId        String?            @db.Uuid
  subscriptionId    String?            @db.Uuid
  invoiceId         String?            @db.Uuid
  type              NotificationType
  status            NotificationStatus @default(PENDING)
  dedupeKey         String             @unique @db.VarChar(240)
  recipientEmail    String             @db.VarChar(320)
  subject           String             @db.VarChar(240)
  bodyText          String             @db.Text
  bodyHtml          String?            @db.Text
  attempts          Int                @default(0) @db.Integer
  maxAttempts       Int                @default(5) @db.Integer
  nextAttemptAt     DateTime?          @db.Timestamptz(3)
  queuedAt          DateTime?          @db.Timestamptz(3)
  lastError         String?            @db.Text
  providerName      String?            @db.VarChar(40)
  providerMessageId String?            @db.VarChar(200)
  sentAt            DateTime?          @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([organizationId, type, createdAt])
  @@map("notifications")
}

model GatewayWebhookEvent {
  id              String              @id @default(uuid()) @db.Uuid
  provider        String              @db.VarChar(40)
  providerEventId String              @db.VarChar(160)
  eventType       String              @db.VarChar(80)
  status          GatewayWebhookStatus @default(RECEIVED)
  payload         Json
  organizationId  String?             @db.Uuid
  paymentId       String?             @db.Uuid
  error           String?             @db.Text
  receivedAt      DateTime            @default(now()) @db.Timestamptz(3)
  processedAt     DateTime?           @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([provider, eventType, receivedAt])
  @@map("gateway_webhook_events")
}
