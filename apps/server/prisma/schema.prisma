generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum CustomerStatus {
  ACTIVE
  ARCHIVED
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(320)
  name         String    @db.VarChar(160)
  passwordHash String    @db.VarChar(100)
  lastLoginAt  DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  memberships OrganizationMember[]
  sessions    Session[]

  @@map("users")
}

model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(160)
  slug            String   @unique @db.VarChar(80)
  defaultCurrency String   @default("USD") @db.VarChar(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  members       OrganizationMember[]
  activeSessions Session[]            @relation("ActiveOrganizationSessions")
  customers     Customer[]
  plans         Plan[]
  subscriptions Subscription[]
  invoices      Invoice[]

  @@map("organizations")
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  tokenHash            String   @unique @db.VarChar(64)
  userId               String   @db.Uuid
  activeOrganizationId String?  @db.Uuid
  expiresAt            DateTime @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt           DateTime @default(now()) @db.Timestamptz(3)

  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization Organization? @relation("ActiveOrganizationSessions", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Customer {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  name           String         @db.VarChar(160)
  email          String         @db.VarChar(320)
  externalId     String?        @db.VarChar(160)
  status         CustomerStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  invoices      Invoice[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("customers")
}

model Plan {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  name           String          @db.VarChar(120)
  code           String          @db.VarChar(60)
  description    String?         @db.Text
  amount         Decimal         @db.Decimal(12, 2)
  currency       String          @default("USD") @db.VarChar(3)
  interval       BillingInterval @default(MONTH)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  customerId         String             @db.Uuid
  planId             String             @db.Uuid
  status             SubscriptionStatus @default(TRIALING)
  quantity           Int                @default(1)
  currentPeriodStart DateTime?          @db.Timestamptz(3)
  currentPeriodEnd   DateTime?          @db.Timestamptz(3)
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan         Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices     Invoice[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([planId])
  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  customerId     String        @db.Uuid
  subscriptionId String?       @db.Uuid
  number         String        @db.VarChar(60)
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD") @db.VarChar(3)
  issuedAt       DateTime      @default(now()) @db.Timestamptz(3)
  dueAt          DateTime      @db.Timestamptz(3)
  paidAt         DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([customerId])
  @@map("invoices")
}
