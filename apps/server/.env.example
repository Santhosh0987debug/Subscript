# Server
NODE_ENV=development
PORT=4000

# PostgreSQL connection string.
# Leave commented to use the local in-memory auth store (development only).
# Required in production.
# DATABASE_URL="postgresql://subscript:subscript_dev@localhost:5432/subscript?schema=public"

# Comma-separated list of allowed browser origins. Wildcards are intentionally rejected.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# Session lifetime in days.
SESSION_TTL_DAYS=7

# bcrypt cost. 12 is the production default.
BCRYPT_COST=12

# Set to true when serving over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# Set to true only when the API runs behind a trusted reverse proxy.
TRUST_PROXY=false

# Razorpay gateway (optional). Leave all three blank to keep online checkout
# disabled; manual payment recording still works.
#
# Use Test Mode keys from the Razorpay dashboard during development. Keys
# beginning with rzp_live_ are rejected outside NODE_ENV=production.
# RAZORPAY_KEY_ID="rzp_test_your_key_id"
# RAZORPAY_KEY_SECRET="your_test_key_secret"
#
# Create the webhook in Razorpay Dashboard > Account & Settings > Webhooks:
#   URL:    https://your-api.example.com/api/webhooks/razorpay
#   Secret: the same value as RAZORPAY_WEBHOOK_SECRET
#   Events: payment.captured, payment.failed, order.paid,
#           refund.created, refund.processed, refund.failed
# RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"

# Background automation (optional). The API starts without Redis and reports
# automation as disabled. The worker process requires both DATABASE_URL and
# REDIS_URL; it is started separately with:
#   npm run dev:worker -w @subscript/server
# REDIS_URL="redis://localhost:6379"
#
# Queue namespace and worker concurrency.
# AUTOMATION_QUEUE_PREFIX="subscript"
# AUTOMATION_BILLING_CONCURRENCY=5
# AUTOMATION_NOTIFICATION_CONCURRENCY=5
#
# How often each worker cluster scans for due renewals, trials, and failed
# payments.
# AUTOMATION_SWEEP_INTERVAL_SECONDS=60
#
# Scheduling windows and generated-invoice defaults.
# AUTOMATION_RENEWAL_REMINDER_WINDOW_DAYS=7
# AUTOMATION_TRIAL_REMINDER_WINDOW_DAYS=3
# AUTOMATION_INVOICE_DUE_IN_DAYS=7
# AUTOMATION_INVOICE_TAX_RATE_BPS=0
#
# Bounded retry policy for durable jobs.
# AUTOMATION_JOB_MAX_ATTEMPTS=5
# AUTOMATION_JOB_BACKOFF_BASE_SECONDS=60
# AUTOMATION_JOB_BACKOFF_MAX_SECONDS=3600
#
# Payment recovery sends dunning notifications only. It never initiates a
# Razorpay charge. When attempts are exhausted, the subscription is marked
# past due by default; set CANCEL to cancel it instead.
# AUTOMATION_PAYMENT_RETRY_BASE_MINUTES=60
# AUTOMATION_PAYMENT_RETRY_MAX_MINUTES=1440
# AUTOMATION_PAYMENT_RETRY_MAX_ATTEMPTS=4
# AUTOMATION_PAYMENT_EXHAUSTION_ACTION="MARK_PAST_DUE"
# AUTOMATION_PAST_DUE_EXPIRY_DAYS=30
# AUTOMATION_WORKER_STALE_SECONDS=300
#
# Notification delivery retries.
# NOTIFICATION_MAX_ATTEMPTS=5
# NOTIFICATION_RETRY_BASE_SECONDS=60
# NOTIFICATION_RETRY_MAX_SECONDS=3600
#
# Email sender and optional SMTP. Without SMTP_HOST, notifications are written
# to the development log adapter and no email leaves the machine. SMTP_USER and
# SMTP_PASSWORD must be set together.
# EMAIL_FROM="Subscript <no-reply@subscript.local>"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=""
# SMTP_PASSWORD=""
